{
  "name": "relic",
  "version": "1.0.0",
  "private": true,
  "description": "Relic — CockroachDB-backed agentic memory for on-call agent fleets",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
