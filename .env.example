# CockroachDB (local docker-compose or CockroachDB Cloud)
DATABASE_URL=postgresql://root@127.0.0.1:26257/relic?sslmode=disable

# Optional: CockroachDB Cloud MCP (Cursor / Claude). Paste the snippet from
# https://cockroachlabs.cloud/mcp into mcp/cockroachdb.mcp.json
COCKROACH_MCP_URL=
COCKROACH_MCP_TOKEN=

# Optional: ccloud CLI (agent-ready control plane)
CCLOUD_API_KEY=
CCLOUD_API_SECRET=
CCLOUD_CLUSTER_ID=

# AWS — put keys here or export in your shell. Relic degrades to local
# embeddings + MinIO when these are unset.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=relic
AWS_SECRET_ACCESS_KEY=relicrelic
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
S3_BUCKET=relic-agent-artifacts
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=relic
MINIO_ROOT_PASSWORD=relicrelic

# Demo
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
